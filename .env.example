# Database location
DATABASE_URL=./data/duomi.db

# Enable demo data seeding (seeding mock values on startup if database tables are empty)
DEMO_MODE=false

# User display names
PUBLIC_PERSON_A_NAME=Partner A
PUBLIC_PERSON_B_NAME=Partner B

# Swish phone numbers (optional, enables Swish settlement button when recipient has a number)
# PUBLIC_PERSON_A_SWISH=0731234567
# PUBLIC_PERSON_B_SWISH=0737654321

# Localization settings
LOCALE=en-US
CURRENCY=USD

# Passphrase protection (set for public self-hosting, leave empty to disable auth)
SECRET_APP_PASSPHRASE=dummy_passphrase_for_testing

# Application origin (required when running behind a reverse proxy to avoid CSRF blocks)
# ORIGIN=https://duomi.yourdomain.com

